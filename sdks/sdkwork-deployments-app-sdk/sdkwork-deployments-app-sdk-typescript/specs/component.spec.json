{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "@sdkwork/deployments-app-sdk",
    "displayName": "SDKWork Deploy App SDK TypeScript Facade",
    "version": "0.1.0",
    "type": "typescript-sdk-facade",
    "root": "sdks/sdkwork-deployments-app-sdk/sdkwork-deployments-app-sdk-typescript",
    "domain": "deploy",
    "capability": "deploy",
    "surface": "app",
    "languages": ["typescript"],
    "generated": false,
    "status": "active",
    "manifests": ["package.json", "tsconfig.json", "specs/component.spec.json"]
  },
  "canonicalSpecs": [
    {"file": "SDK_SPEC.md", "path": "../../../../sdkwork-specs/SDK_SPEC.md", "purpose": "Consumer facade and generated transport boundary."},
    {"file": "SDK_WORKSPACE_GENERATION_SPEC.md", "path": "../../../../sdkwork-specs/SDK_WORKSPACE_GENERATION_SPEC.md", "purpose": "TypeScript SDK workspace and output placement."},
    {"file": "APP_SDK_INTEGRATION_SPEC.md", "path": "../../../../sdkwork-specs/APP_SDK_INTEGRATION_SPEC.md", "purpose": "App SDK consumer import and injection rules."},
    {"file": "COMPONENT_SPEC.md", "path": "../../../../sdkwork-specs/COMPONENT_SPEC.md", "purpose": "Component-local contract requirements."},
    {"file": "TYPESCRIPT_CODE_SPEC.md", "path": "../../../../sdkwork-specs/TYPESCRIPT_CODE_SPEC.md", "purpose": "Strict TypeScript package rules."},
    {"file": "TEST_SPEC.md", "path": "../../../../sdkwork-specs/TEST_SPEC.md", "purpose": "Build and type-check verification."}
  ],
  "contracts": {
    "layerRole": "sdk-facade",
    "publicExports": ["src/index.ts", "composed/applicationPublisher/index.ts"],
    "providedPorts": [],
    "requiredPorts": [],
    "runtimeEntrypoints": ["package.json#exports."],
    "routeManifest": null,
    "sdkClients": ["SdkworkDeployAppClient", "SdkworkDriveAppClient"],
    "sdkDependencies": [
      {
        "workspace": "sdkwork-drive-app-sdk",
        "role": "drive-uploader-capability",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": "/app/v3/api",
        "apiAuthority": "sdkwork-drive-app-api",
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/drive-app-sdk"
        }
      }
    ],
    "dependencyApiExports": [
      {
        "workspace": "sdkwork-drive-app-sdk",
        "sdkFamily": "sdkwork-drive-app-sdk",
        "apiAuthority": "sdkwork-drive-app-api",
        "surface": "app-api",
        "apiPrefix": "/app/v3/api",
        "exportMode": "composed-wrapper",
        "visibility": "app",
        "methods": ["uploader.uploadArchive"],
        "packageExport": "./application-publisher",
        "runtimeRequired": true
      }
    ],
    "dependencyApiSurfaces": [
      {
        "workspace": "sdkwork-drive-app-sdk",
        "apiAuthority": "sdkwork-drive-app-api",
        "surface": "app-api",
        "runtimeMode": "external-service",
        "sameOriginAllowed": false,
        "requiredBaseUrlKey": "SDKWORK_DRIVE_FACADE_URL",
        "authMode": "dual-token"
      }
    ],
    "events": [],
    "configKeys": []
  },
  "verification": {
    "commands": [
      "pnpm --filter @sdkwork/deployments-app-sdk typecheck",
      "pnpm --filter @sdkwork/deployments-app-sdk test",
      "pnpm --filter @sdkwork/deployments-app-sdk build"
    ]
  }
}
