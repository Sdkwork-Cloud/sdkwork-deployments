# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=cloud
SDKWORK_DEPLOY_ENVIRONMENT=staging
SDKWORK_DEPLOY_PROFILE_ID=cloud.staging
SDKWORK_DEPLOY_APPLICATION_PUBLIC_HTTP_URL=https://deploy-staging.sdkwork.com
SDKWORK_DEPLOY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DEPLOY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

