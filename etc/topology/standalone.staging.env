# Bootstrap profile standalone.staging — replace with application-specific values.
SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DEPLOY_ENVIRONMENT=staging
SDKWORK_DEPLOY_PROFILE_ID=standalone.staging
SDKWORK_DEPLOY_APPLICATION_PUBLIC_HTTP_URL=https://deploy-staging.sdkwork.com
SDKWORK_DEPLOY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DEPLOY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
